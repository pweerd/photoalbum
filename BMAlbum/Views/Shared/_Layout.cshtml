@using Bitmanager.Web
<!DOCTYPE html>
<html lang="nl" class="bordered-slimbar">
<head>
   <meta charset="utf-8" />
   <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1,viewport-fit=cover" />
   <link rel="icon" href="~/favicon.svg" />
   <link rel="apple-touch-icon" href="~/favicon-180.png">
   <link rel="shortcut icon" href="~/favicon-180.png">
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

   <title>@ViewData["Title"]</title>
   @Bundles.Render(Model.RequestCtx, BundleType.Css, "main")
   @RenderSection("Heads", required: false)
</head>
<body class="fullwidth">
   @RenderBody()
   @Bundles.Render(Model.RequestCtx, BundleType.Js, "main")
   @RenderSection("Scripts", required: false)
</body>
</html>
