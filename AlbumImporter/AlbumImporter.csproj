<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
   <PropertyGroup>
      <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
      <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
      <OutputType>Library</OutputType>
      <TargetFramework>net8.0-windows</TargetFramework>
      <Nullable>disable</Nullable>
      <UseWindowsForms>false</UseWindowsForms>
      <ImplicitUsings>enable</ImplicitUsings>
      <AssemblyName>AlbumImporter</AssemblyName>
      <RootNamespace>AlbumImporter</RootNamespace>
      <NoWarn>$(NoWarn);CA1416</NoWarn>
      <RollForward>Major</RollForward>
      <bmversion>220</bmversion>
      <Platforms>AnyCPU;x64</Platforms>
   </PropertyGroup>
   <ItemGroup>
      <PackageReference Include="CoenM.ImageSharp.ImageHash" Version="1.3.6" />
      <PackageReference Include="FaceAiSharp.Bundle" Version="0.5.23" />
      <PackageReference Include="MetadataExtractor" Version="2.9.0" />
      <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
      <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
      <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
      <PackageReference Include="Shipwreck.Phash" Version="0.5.0" />
      <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
   </ItemGroup>
   <ItemGroup>
      <ProjectReference Include="..\BMAlbumTools\BMAlbumTools.csproj" />
   </ItemGroup>
   <ItemGroup>
      <Reference Include="bmcore$(bmversion)">
         <HintPath>..\_References\BMCore$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="BMElastic$(bmversion)">
         <HintPath>..\_References\BMElastic$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="BMGps$(bmversion)">
         <HintPath>..\_References\BMGps$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="BMHttp$(bmversion)">
         <HintPath>..\_References\BMHttp$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="BMImage$(bmversion)">
         <HintPath>..\_References\BMImage$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="BMOcr$(bmversion)">
         <HintPath>..\_References\BMOcr$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="bmir$(bmversion)">
         <HintPath>..\_References\bmir$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="BMWebService$(bmversion)">
         <HintPath>..\_References\BMWebService$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="ImportPipeline$(bmversion)">
         <HintPath>..\_References\ImportPipeline$(bmversion).dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
      <Reference Include="SixLabors.ImageSharp">
         <HintPath>..\..\_References\SixLabors.ImageSharp.dll</HintPath>
         <SpecificVersion>False</SpecificVersion>
      </Reference>
   </ItemGroup>
</Project>